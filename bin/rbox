#!/usr/bin/env bash
# rbox - per-project CPU/RAM capped sandbox for AI-driven commands on macOS.
# Backed by OrbStack's Linux VM (cgroup v2). See README.md.
set -uo pipefail

IMAGE_DEFAULT="rbox:local"
GLOBAL_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/rbox/default.toml"

die()  { printf 'rbox: %s\n' "$*" >&2; exit 1; }
info() { printf 'rbox: %s\n' "$*" >&2; }

# ---------- project identity ----------
project_dir() {
  local d
  d="$(git rev-parse --show-toplevel 2>/dev/null)" || d=""
  [[ -n "$d" ]] || d="$PWD"
  # resolve symlinks so the hash is stable
  (cd "$d" && pwd -P)
}

# rbox-<sanitized project name>-<8 char path hash>
container_name() {
  local dir="$1" base hash
  base="$(basename "$dir" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_.-' '-' | sed 's/^[^a-z0-9]*//; s/-\+/-/g; s/-$//')"
  [[ -n "$base" ]] || base="project"
  hash="$(printf '%s' "$dir" | shasum -a 256 | cut -c1-8)"
  printf 'rbox-%s-%s' "$base" "$hash"
}

# ---------- config ----------
# Minimal TOML reader: `key = value`, strips quotes/comments. Enough for our flat schema.
cfg_get() {
  local key="$1" file="$2"
  [[ -f "$file" ]] || return 1
  sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$/\1/p" "$file" \
    | head -1 \
    | sed -E 's/[[:space:]]*#.*$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/; s/[[:space:]]*$//'
}

# Read `key = ["a", "b"]` (single line) into one item per output line.
cfg_get_array() {
  local key="$1" file="$2" raw
  [[ -f "$file" ]] || return 1
  raw="$(sed -n -E "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\[(.*)\].*$/\1/p" "$file" | head -1)"
  [[ -n "$raw" ]] || return 1
  printf '%s' "$raw" | tr ',' '\n' | sed -E 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/' | grep -v '^$'
}

# project .rbox.toml -> global default.toml -> built-in
load_cfg() {
  local dir="$1" local_cfg="$1/.rbox.toml" v arr
  CPUS=4; MEMORY="6g"; PIDS=512; IMAGE="$IMAGE_DEFAULT"; ISOLATE_NM="false"
  SETUP=""; CFG_FILE=""
  VOLUMES=(); ENVS=()
  local f
  for f in "$GLOBAL_CFG" "$local_cfg"; do
    [[ -f "$f" ]] || continue
    CFG_FILE="$f"
    v="$(cfg_get cpus                 "$f")" && [[ -n "$v" ]] && CPUS="$v"
    v="$(cfg_get memory               "$f")" && [[ -n "$v" ]] && MEMORY="$v"
    v="$(cfg_get pids                 "$f")" && [[ -n "$v" ]] && PIDS="$v"
    v="$(cfg_get image                "$f")" && [[ -n "$v" ]] && IMAGE="$v"
    v="$(cfg_get isolate_node_modules "$f")" && [[ -n "$v" ]] && ISOLATE_NM="$v"
    v="$(cfg_get setup                "$f")" && [[ -n "$v" ]] && SETUP="$v"
    # arrays: volumes = ["name:/path", ...]   env = ["K=V", ...]
    arr="$(cfg_get_array volumes "$f")" && [[ -n "$arr" ]] && { VOLUMES=(); while IFS= read -r x; do [[ -n "$x" ]] && VOLUMES+=("$x"); done <<< "$arr"; }
    arr="$(cfg_get_array env     "$f")" && [[ -n "$arr" ]] && { ENVS=();    while IFS= read -r x; do [[ -n "$x" ]] && ENVS+=("$x");    done <<< "$arr"; }
  done
  # integer job count for parallelism env vars (round down; min 1)
  JOBS="${CPUS%%.*}"; [[ "$JOBS" =~ ^[0-9]+$ ]] || JOBS=1; (( JOBS < 1 )) && JOBS=1
  return 0
}

# ---------- docker plumbing ----------
require_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found. Install OrbStack: brew install orbstack"
  # Prefer OrbStack's socket directly; the docker context is not always active.
  if [[ -z "${DOCKER_HOST:-}" && -S "$HOME/.orbstack/run/docker.sock" ]]; then
    export DOCKER_HOST="unix://$HOME/.orbstack/run/docker.sock"
  fi
  if ! docker info >/dev/null 2>&1; then
    die "Docker daemon not reachable. Start OrbStack first:  orb start"
  fi
}

container_state() { docker inspect -f '{{.State.Status}}' "$1" 2>/dev/null; }

ensure_container() {
  local name="$1" dir="$2"
  local state; state="$(container_state "$name")"

  if [[ -n "$state" ]]; then
    # Resource caps are fixed at creation time, so a changed .rbox.toml
    # requires recreating the container - even if it is currently running.
    local want_cpu cur_cpu want_mem cur_mem want_pids cur_pids
    want_cpu="$(awk -v c="$CPUS" 'BEGIN{printf "%d", c*1000000000}')"
    cur_cpu="$(docker inspect -f '{{.HostConfig.NanoCpus}}' "$name" 2>/dev/null)"
    want_mem="$(mem_to_bytes "$MEMORY")"
    cur_mem="$(docker inspect -f '{{.HostConfig.Memory}}' "$name" 2>/dev/null)"
    want_pids="$PIDS"
    cur_pids="$(docker inspect -f '{{.HostConfig.PidsLimit}}' "$name" 2>/dev/null)"
    if [[ "$want_cpu" != "$cur_cpu" || "$want_mem" != "$cur_mem" || "$want_pids" != "$cur_pids" ]]; then
      info "config changed - recreating container (cpus=$CPUS memory=$MEMORY pids=$PIDS)"
      docker rm -f "$name" >/dev/null 2>&1
    elif [[ "$state" == "running" ]]; then
      return 0
    else
      if docker start "$name" >/dev/null 2>&1; then run_setup "$name"; return 0; fi
      docker rm -f "$name" >/dev/null 2>&1
    fi
  fi

  image_exists "$IMAGE" || build_image

  local -a args=(
    -d --name "$name"
    --label rbox.project="$dir"
    --restart=no
    --cpus="$CPUS"
    --memory="$MEMORY" --memory-swap="$MEMORY"   # both: --memory alone does NOT hard-cap
    --pids-limit="$PIDS"
    -v "$dir:/work"
    -w /work
    -e MAKEFLAGS="-j${JOBS}"
    -e CARGO_BUILD_JOBS="$JOBS"
    -e NPM_CONFIG_JOBS="$JOBS"
    -e UV_CONCURRENT_BUILDS="$JOBS"
    -e RBOX=1
  )
  [[ "$ISOLATE_NM" == "true" ]] && args+=( -v "${name}-nm:/work/node_modules" )

  # user-declared persistent volumes: "toolchain:/root/.elan" -> auto-namespaced
  local vspec vname vpath
  for vspec in ${VOLUMES+"${VOLUMES[@]}"}; do
    vname="${vspec%%:*}"; vpath="${vspec#*:}"
    [[ "$vname" == /* ]] && { args+=( -v "$vspec" ); continue; }   # absolute host path
    args+=( -v "${name}-${vname}:${vpath}" )
  done
  local e
  for e in ${ENVS+"${ENVS[@]}"}; do args+=( -e "$e" ); done

  docker run "${args[@]}" "$IMAGE" sleep infinity >/dev/null \
    || die "failed to start sandbox container"
  info "started $name (cpus=$CPUS memory=$MEMORY pids=$PIDS)"
  run_setup "$name"
}

mem_to_bytes() {
  local m="${1,,}" n unit
  n="${m%[gmk]*}"; unit="${m##*[0-9]}"
  case "$unit" in
    g|gb) awk -v n="$n" 'BEGIN{printf "%d", n*1024*1024*1024}' ;;
    m|mb) awk -v n="$n" 'BEGIN{printf "%d", n*1024*1024}' ;;
    k|kb) awk -v n="$n" 'BEGIN{printf "%d", n*1024}' ;;
    *)    printf '%d' "$n" ;;
  esac
}

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

build_image() {
  local ctx; ctx="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  [[ -f "$ctx/Dockerfile" ]] || die "Dockerfile not found at $ctx"
  info "building $IMAGE (first run only, takes a few minutes)..."
  docker build -t "$IMAGE" "$ctx" >&2 || die "image build failed"
}

# Run the project's `setup` script once per container lifetime.
# Marker lives inside the container, so recreating it re-runs setup.
run_setup() {
  local name="$1" e
  [[ -n "$SETUP" ]] || return 0
  if docker exec "$name" test -f /var/lib/rbox-setup-done 2>/dev/null; then return 0; fi
  local RBOX_PATH_VAL=""
  for e in ${ENVS+"${ENVS[@]}"}; do [[ "$e" == PATH=* ]] && RBOX_PATH_VAL="${e#PATH=}"; done
  info "running setup (once per container)..."
  # A login shell sources /etc/profile, which overwrites PATH and would discard
  # the PATH from `env` in .rbox.toml. Re-apply it, and disable command hashing
  # so tools installed mid-script are found immediately.
  if docker exec -w /work -e RBOX_SETUP="$SETUP" -e RBOX_PATH="$RBOX_PATH_VAL" "$name" bash -lc \
       'set +h; [ -n "$RBOX_PATH" ] && export PATH="$RBOX_PATH"; set -e; eval "$RBOX_SETUP"' \
       ; then
    docker exec "$name" touch /var/lib/rbox-setup-done >/dev/null 2>&1
    info "setup complete"
  else
    die "setup failed. Fix 'setup' in ${CFG_FILE:-.rbox.toml}, then run: rbox rm && rbox <cmd>"
  fi
}

# ---------- subcommands ----------
cmd_init() {
  local dir="$1" tgt="$1/.rbox.toml"
  if [[ -f "$tgt" ]]; then info "already exists: $tgt"; return 0; fi
  local tpl; tpl="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/templates/rbox.toml"
  if [[ -f "$tpl" ]]; then cp "$tpl" "$tgt"; else
    cat > "$tgt" <<'TOML'
cpus   = 4
memory = "6g"
pids   = 512
image  = "rbox:local"
isolate_node_modules = false
TOML
  fi
  info "created $tgt"
}

cmd_status() {
  local name="$1" dir="$2"
  local state; state="$(container_state "$name")"
  printf 'project : %s\n' "$dir"
  printf 'container: %s\n' "$name"
  printf 'config   : cpus=%s memory=%s pids=%s image=%s\n' "$CPUS" "$MEMORY" "$PIDS" "$IMAGE"
  printf 'state    : %s\n' "${state:-not created}"
  if [[ "$state" == "running" ]]; then
    docker stats --no-stream --format '  live   : CPU={{.CPUPerc}} MEM={{.MemUsage}} PIDS={{.PIDs}}' "$name"
  fi
}

cmd_ls() {
  printf '%-40s %-10s %s\n' "CONTAINER" "STATE" "PROJECT"
  docker ps -a --filter 'name=^rbox-' \
    --format '{{.Names}}\t{{.State}}\t{{.Label "rbox.project"}}' 2>/dev/null \
    | while IFS=$'\t' read -r n s p; do printf '%-40s %-10s %s\n' "$n" "$s" "$p"; done
}

cmd_stop() { docker stop "$1" >/dev/null 2>&1 && info "stopped $1" || info "not running"; }
cmd_rm()   { docker rm -f "$1" >/dev/null 2>&1 && info "removed $1" || info "nothing to remove"; }

cmd_run() {
  local name="$1" dir="$2"; shift 2
  ensure_container "$name" "$dir"

  # Run relative to the caller's cwd inside the project, not just the project root.
  # Resolve cwd the same way project_dir does so the prefix actually matches
  # (macOS is case-insensitive and /tmp is a symlink to /private/tmp).
  local here rel workdir
  here="$(pwd -P)"
  rel="${here#"$dir"}"
  if [[ "$rel" == "$here" ]]; then
    rel=""              # not under $dir (case/symlink mismatch): fall back to root
  fi
  rel="${rel#/}"
  workdir="/work${rel:+/$rel}"

  local -a tty=()
  [[ -t 0 && -t 1 ]] && tty=(-it)

  # Re-apply the configured PATH: `bash -l` sources /etc/profile, which would
  # otherwise discard a custom PATH set via `env` in .rbox.toml.
  local e rbox_path=""
  for e in ${ENVS+"${ENVS[@]}"}; do [[ "$e" == PATH=* ]] && rbox_path="${e#PATH=}"; done
  docker exec "${tty[@]}" -w "$workdir" -e RBOX_PATH="$rbox_path" \
    -e RBOX_CMD="$(printf '%q ' "$@")" "$name" \
    bash -lc '[ -n "$RBOX_PATH" ] && export PATH="$RBOX_PATH"; eval "$RBOX_CMD"' 
  local rc=$?
  if (( rc == 137 )); then
    info "exit 137 = OOM-killed: hit the ${MEMORY} RAM cap (not necessarily a bug in your command)."
    info "raise 'memory' in ${dir}/.rbox.toml if the command legitimately needs more."
  fi
  return $rc
}

usage() {
  cat <<'USAGE'
rbox - per-project CPU/RAM capped sandbox (OrbStack + cgroup v2)

  rbox <command...>   run a command inside this project's sandbox
  rbox init           create .rbox.toml in this project
  rbox status         show this project's container state + live usage
  rbox ls             list rbox containers across all projects
  rbox stop | rm      stop / remove this project's container
  rbox build          (re)build the rbox image
  rbox setup          re-run this project's `setup` script
  rbox help

Config: <project>/.rbox.toml -> ~/.config/rbox/default.toml -> built-in (4 cpus / 6g)
Note: git, gh, ssh, docker must run on the host, NOT through rbox.
USAGE
}

main() {
  local dir name
  dir="$(project_dir)"
  load_cfg "$dir"
  name="$(container_name "$dir")"

  case "${1-}" in
    ""|help|-h|--help) usage; exit 0 ;;
    init)    cmd_init "$dir" ;;
    status)  require_docker; cmd_status "$name" "$dir" ;;
    ls)      require_docker; cmd_ls ;;
    stop)    require_docker; cmd_stop "$name" ;;
    rm)      require_docker; cmd_rm "$name" ;;
    build)   require_docker; build_image ;;
    setup)   require_docker
             [[ -n "$SETUP" ]] || die "no 'setup' defined in .rbox.toml"
             ensure_container "$name" "$dir"
             docker exec "$name" rm -f /var/lib/rbox-setup-done >/dev/null 2>&1
             run_setup "$name" ;;
    *)       require_docker; cmd_run "$name" "$dir" "$@" ;;
  esac
}

main "$@"
